<?xml version="1.0" encoding="utf-8"?>
<!--
  MyApps 图标背景层（自适应图标 background）。
  品牌基调：深海军蓝 → 青绿渐变，代表「从外网进入内网」。
  本文件由项目负责人于 CMP-50 预置为可用的兜底素材；Designer 交付正式稿后可直接替换。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF0B2E63"
                android:endColor="#FF0FA3A3" />
        </aapt:attr>
    </path>

    <!-- 底纹：两条极淡的对角光带，避免纯色渐变过于扁平 -->
    <path
        android:pathData="M0,96 L34,0 L46,0 L12,108 L0,108 Z"
        android:fillColor="#14FFFFFF" />
    <path
        android:pathData="M64,108 L108,0 L108,34 L86,108 Z"
        android:fillColor="#0FFFFFFF" />
</vector>
