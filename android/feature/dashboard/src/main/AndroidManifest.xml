<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
          桌面 Widget：展示收藏服务，点击直达 Custom Tab。
          声明在库模块里，由 AGP 合并进宿主 App 的清单（不动 :app 的 AndroidManifest）。
        -->
        <receiver
            android:name="com.hubdeck.app.ui.dashboard.widget.HubDeckWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hubdeck_widget_info" />
        </receiver>

        <!-- 绑定 Widget 列表数据的服务（Hilt 注入端口）。 -->
        <service
            android:name="com.hubdeck.app.ui.dashboard.widget.WidgetRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Widget 点击后拉起 Custom Tab 的中转 Activity。 -->
        <activity
            android:name="com.hubdeck.app.ui.dashboard.widget.WidgetLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.HubDeck.Widget.Transparent" />

    </application>

</manifest>
